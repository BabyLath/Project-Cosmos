# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/oms?schema=public"

# Port the Express server listens on
PORT=4000

# Origin allowed to make credentialed requests (the Next.js frontend)
CORS_ORIGIN="http://localhost:3000"

# Set to "production" to enable secure cookie flags and hide stack traces
NODE_ENV="development"

# Session cookie lifetime, in days
SESSION_TTL_DAYS=7

# Password reset token lifetime, in minutes
RESET_TOKEN_TTL_MINUTES=30

# --- Email (password reset) ---
# If unset, the backend logs reset links to the console instead of
# sending email. Fill these in for real delivery (e.g. via SMTP).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="OMS <no-reply@example.org>"

# --- Initial admin account (used by prisma/seed.ts) ---
SEED_ADMIN_EMAIL="admin@example.org"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="System Administrator"
